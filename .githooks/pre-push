#!/bin/bash

# Beru Pre-Push Hook
# Enforces formatting, linting, and tests prior to remote push.

set -e

PREFIX="[beru:pre-push]"

echo "$PREFIX Executing pre-push verification pipeline..."

# 1. Format Check
echo "$PREFIX [1/3] Validating code formatting (cargo fmt)..."
if ! cargo fmt --all -- --check; then
    echo "$PREFIX FATAL: Code formatting check failed." >&2
    echo "$PREFIX HINT: Run 'cargo fmt --all' to format the codebase." >&2
    exit 1
fi

# 2. Lint Check
echo "$PREFIX [2/3] Validating lints (cargo clippy)..."
if ! cargo clippy --workspace --all-targets --all-features -- -D warnings; then
    echo "$PREFIX FATAL: Clippy linting failed." >&2
    echo "$PREFIX HINT: Resolve the warnings above before pushing." >&2
    exit 1
fi

# 3. Test Suite
echo "$PREFIX [3/3] Running unit and integration tests..."
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" ]]; then
    echo "$PREFIX Skipping tests in pre-push hook on Windows due to Git Bash/CMake conflicts."
    echo "$PREFIX Please ensure you run 'cargo test' manually in a native terminal before pushing."
else
    cargo test --workspace -- --test-threads=1
    if [ $? -ne 0 ]; then
        echo "$PREFIX FATAL: Test suite failed." >&2
        echo "$PREFIX HINT: Ensure all unit and integration tests pass." >&2
        exit 1
    fi
fi

echo "$PREFIX Pipeline completed successfully. Proceeding with git push."
exit 0
